{
  "name": "rona",
  "version": "0.1.1",
  "description": "Privacy-first ambient-light browser extension for YouTube watch pages",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js --watch",
    "build": "node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "package": "npm run build && node scripts/package-extension.js",
    "release": "npm run package && node scripts/create-github-release.js"
  },
  "keywords": [
    "chrome-extension",
    "youtube",
    "ambient-light",
    "manifest-v3",
    "privacy-first"
  ],
  "author": "Armand Habib Bachtiar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4rmnd/rona.git"
  },
  "homepage": "https://github.com/4rmnd/rona#readme",
  "bugs": {
    "url": "https://github.com/4rmnd/rona/issues"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^3.0.5",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}